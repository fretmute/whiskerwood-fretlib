blueprint BPL_FL_UI : BlueprintFunctionLibrary at /Game/Mods/Fretlib/Lib_1/BPL_FL_UI
use /Game/Mods/Fretlib/Lib_1

// Styling helpers so Fretlib's widgets look like the game's (claude/LoomConventions.md §9). Two styles: StyleText for sidebar
// panels (LibreBaskerville Bold, gold, dark outline, as the details widgets), and StyleMenuText for settings-style screens such
// as the mod menu (Germania One, gold, no outline, as the game's settings screen). Values from the game's widget dumps.

category "Fretlib|UI"

// The game's gold for labels and values.
//
// In:  none
// Out: Return - the colour.
pure fn Gold() -> LinearColor {
    return LinearColor(R: 0.73791, G: 0.527115, B: 0.205079, A: 1.0)
}

// Sets a text block to the game's label style: LibreBaskerville Bold at a size, gold, with a 1 px dark outline.
//
// In:  Target - the text block (or LocTextBlock).
//      FontSize - the font size (16 for rows, 18-20 for headings, 14 for small text).
// Out: Return - false if the font couldn't be loaded (the text keeps its old font).
fn StyleText(Target: TextBlock, FontSize: float) -> bool {
    if Target == none {
        return false
    }
    let fontRef: soft<Font> = /Game/Assets/Fonts/LibreBaskerville/LibreBaskerville-Bold_Font.LibreBaskerville-Bold_Font
    let fontObject = fontRef.load()
    if fontObject == none {
        return false
    }
    let font = Target.Font
    font.FontObject = fontObject
    font.TypefaceFontName = "Default"
    font.Size = FontSize
    let outline = font.OutlineSettings
    outline.OutlineSize = 1
    outline.OutlineColor = LinearColor(R: 0.005208, G: 0.002832, B: 0.000444, A: 1.0)
    font.OutlineSettings = outline
    Target.SetFont(font)
    Target.SetColorAndOpacity(SlateColor(SpecifiedColor: Gold()))
    return true
}

// The settings-screen font (Germania One) at a size, without an outline, built on an existing font struct (a SlateFontInfo
// literal needs every field, so one is copied).
//
// In:  Base - any font struct to start from (e.g. the target text's own Font).
//      FontSize - the size (20 for rows, 24 headings, 26 titles).
// Out: Return - the font; Base unchanged if Germania One couldn't be loaded.
fn MenuFont(Base: SlateFontInfo, FontSize: float) -> SlateFontInfo {
    let fontRef: soft<Font> = /Game/Assets/Fonts/Germania_One/GermaniaOne-Regular_Font.GermaniaOne-Regular_Font
    let fontObject = fontRef.load()
    let menuFont = Base
    if fontObject == none {
        return menuFont
    }
    menuFont.FontObject = fontObject
    menuFont.TypefaceFontName = "Default"
    menuFont.Size = FontSize
    let outline = menuFont.OutlineSettings
    outline.OutlineSize = 0
    menuFont.OutlineSettings = outline
    return menuFont
}

// Sets a text block to the game's settings-screen style: Germania One at a size, no outline, and (optionally) gold.
//
// In:  Target - the text block (or LocTextBlock).
//      FontSize - the size (20 for rows, 24 headings, 26 titles).
//      bGold - true to colour it gold; false keeps its colour (e.g. a button label the button colours itself).
// Out: none
fn StyleMenuText(Target: TextBlock, FontSize: float, bGold: bool) {
    if Target == none {
        return
    }
    Target.SetFont(MenuFont(Target.Font, FontSize))
    if bGold {
        Target.SetColorAndOpacity(SlateColor(SpecifiedColor: Gold()))
    }
}

// Moves a round button's label up to sit centred: Germania One draws lower in its line than the font the game's buttons were
// laid out for. Only the drawing moves, not the layout.
//
// In:  Label - the button's label (e.g. Arco_Button_CommonRound.ButtonText).
// Out: none
fn CentreMenuButtonLabel(Label: TextBlock) {
    if Label == none {
        return
    }
    Label.SetRenderTranslation(Vector2D(X: 0.0, Y: -3.0))
}

// Prepares one of the game's round text buttons for a settings-style screen: its label key, no icon, the menu font. The button
// resets its label, icon and font to these defaults when it is first shown, so the defaults are set, not just the label.
// Call before the button is shown; call CentreMenuButtonLabel on its ButtonText once it is.
//
// In:  Target - the button.
//      LabelKey - string key of its label.
//      FontSize - the label's size: 22 for 44-high buttons (the bottom bar), 18 for 36-high ones (in rows); a label too tall
//                 for its button overflows downward and looks low.
// Out: none
fn SetupMenuButton(Target: Arco_Button_CommonRound, LabelKey: string, FontSize: float) {
    if Target == none {
        return
    }
    Target.Default_ButtonKey = LabelKey
    Target.UseLocalization = true
    Target.Default_Icon = none
    Target.Font = MenuFont(Target.Font, FontSize)
    Target.SetLabelText(LabelKey)
}

// A rounded brush (half-height corners, like the game's settings rows) in a colour, built on an existing brush (a SlateBrush
// literal needs every field, so one is copied).
//
// In:  Base - any brush to start from.
//      Colour - its colour.
// Out: Return - the brush.
fn RoundedBrush(Base: SlateBrush, Colour: LinearColor) -> SlateBrush {
    let brush = Base
    brush.DrawAs = ESlateBrushDrawType.RoundedBox
    brush.TintColor = SlateColor(SpecifiedColor: Colour)
    let outline = brush.OutlineSettings
    outline.RoundingType = ESlateBrushRoundingType.HalfHeightRadius
    outline.Width = 0.0
    brush.OutlineSettings = outline
    return brush
}
