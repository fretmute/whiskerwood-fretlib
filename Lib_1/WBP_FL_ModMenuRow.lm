blueprint WBP_FL_ModMenuRow : UserWidget at /Game/Mods/Fretlib/Lib_1/WBP_FL_ModMenuRow
use /Game/Mods/Fretlib/Lib_1

// One row of the mod menu's pane, in the staffing panel's row layout without the icon: | name | control |. The name fills the
// left; the control sits in a fixed-width box on the right so controls line up. Controls are the game's own widgets: Bool an
// arcoToggle; Int and Float the round -/+ buttons with the value between; Choice the round buttons as arrows around the chosen
// key's text; Text a text box; Key the game's key icon (or the key's name) and a Change button that captures the next key;
// Action a Run button; IntField and FloatField a number box between the -/+ buttons (checked when committed). The name shows the
// game's own tooltip (TooltipFrame, in a gold outline: WBP_FL_ModMenuTooltip) with the option's name and description; only the name, so it never covers the controls. Edits are staged in
// AC_FL_ModMenu (applied with the menu's Apply), and Edited tells the menu to update its marks. A group row shows only its
// heading. Design: workflows/CommonLibrary/docs/ModMenuPlan.md §4, §5.1, §6.1.

widget Pill: Border(BrushColor: "#00000000", Padding: Margin(Left: 4, Top: 2, Right: 4, Bottom: 2)) {
    widget Root: HorizontalBox {
        widget LeftLine: HR_HorizontalBallDivider slot(Size: SlateChildSize(SizeRule: ESlateSizeRule.Fill, Value: 1.0), VerticalAlignment: EVerticalAlignment.VAlign_Center)
        widget Name: LocTextBlock(Key: "", Justification: ETextJustify.Left) slot(Size: SlateChildSize(SizeRule: ESlateSizeRule.Fill, Value: 1.0), Padding: Margin(Left: 10, Top: 6, Right: 6, Bottom: 6), VerticalAlignment: EVerticalAlignment.VAlign_Center)
        widget RightLine: HR_HorizontalBallDivider slot(Size: SlateChildSize(SizeRule: ESlateSizeRule.Fill, Value: 1.0), VerticalAlignment: EVerticalAlignment.VAlign_Center)
        widget Mark: TextBlock(Text: "*", Justification: ETextJustify.Center) slot(Padding: Margin(Right: 10), VerticalAlignment: EVerticalAlignment.VAlign_Center)
        widget ControlBox: SizeBox(WidthOverride: 220, HeightOverride: 40) slot(Padding: Margin(Right: 10), HorizontalAlignment: EHorizontalAlignment.HAlign_Right, VerticalAlignment: EVerticalAlignment.VAlign_Center) {
            widget Controls: Overlay {
                widget Toggle: arcoToggle slot(HorizontalAlignment: EHorizontalAlignment.HAlign_Right, VerticalAlignment: EVerticalAlignment.VAlign_Center)
                widget Stepper: HorizontalBox slot(HorizontalAlignment: EHorizontalAlignment.HAlign_Fill, VerticalAlignment: EVerticalAlignment.VAlign_Center) {
                    widget LeftBox: SizeBox(WidthOverride: 30, HeightOverride: 30) slot(VerticalAlignment: EVerticalAlignment.VAlign_Center) {
                        widget LeftButton: RoundedButton
                    }
                    widget ValueArea: Overlay slot(Size: SlateChildSize(SizeRule: ESlateSizeRule.Fill, Value: 1.0), VerticalAlignment: EVerticalAlignment.VAlign_Center) {
                        widget ValueText: TextBlock(Text: "", Justification: ETextJustify.Center) slot(HorizontalAlignment: EHorizontalAlignment.HAlign_Center, VerticalAlignment: EVerticalAlignment.VAlign_Center)
                        widget ChoiceText: LocTextBlock(Key: "", Justification: ETextJustify.Center) slot(HorizontalAlignment: EHorizontalAlignment.HAlign_Center, VerticalAlignment: EVerticalAlignment.VAlign_Center)
                        widget NumberInput: EditableTextBox(Justification: ETextJustify.Center) slot(Padding: Margin(Left: 6, Right: 6), HorizontalAlignment: EHorizontalAlignment.HAlign_Fill, VerticalAlignment: EVerticalAlignment.VAlign_Center)
                    }
                    widget RightBox: SizeBox(WidthOverride: 30, HeightOverride: 30) slot(VerticalAlignment: EVerticalAlignment.VAlign_Center) {
                        widget RightButton: RoundedButton
                    }
                }
                widget PlainText: TextBlock(Text: "", Justification: ETextJustify.Center) slot(HorizontalAlignment: EHorizontalAlignment.HAlign_Center, VerticalAlignment: EVerticalAlignment.VAlign_Center)
                widget TextInput: EditableTextBox slot(HorizontalAlignment: EHorizontalAlignment.HAlign_Fill, VerticalAlignment: EVerticalAlignment.VAlign_Center)
                widget KeyArea: HorizontalBox slot(HorizontalAlignment: EHorizontalAlignment.HAlign_Fill, VerticalAlignment: EVerticalAlignment.VAlign_Center) {
                    widget KeyIconBox: SizeBox(WidthOverride: 48, HeightOverride: 36) slot(VerticalAlignment: EVerticalAlignment.VAlign_Center) {
                        widget KeyIconArea: Overlay {
                            widget KeyIcon: Ui_InputHotkeyIcon slot(HorizontalAlignment: EHorizontalAlignment.HAlign_Center, VerticalAlignment: EVerticalAlignment.VAlign_Center)
                            widget KeyText: TextBlock(Text: "", Justification: ETextJustify.Center) slot(HorizontalAlignment: EHorizontalAlignment.HAlign_Center, VerticalAlignment: EVerticalAlignment.VAlign_Center)
                        }
                    }
                    widget KeyButtonBox: SizeBox(HeightOverride: 36) slot(Size: SlateChildSize(SizeRule: ESlateSizeRule.Fill, Value: 1.0), Padding: Margin(Left: 8), VerticalAlignment: EVerticalAlignment.VAlign_Center) {
                        widget KeyButton: Arco_Button_CommonRound
                    }
                }
                widget ActionBox: SizeBox(HeightOverride: 36) slot(HorizontalAlignment: EHorizontalAlignment.HAlign_Fill, VerticalAlignment: EVerticalAlignment.VAlign_Center) {
                    widget ActionButton: Arco_Button_CommonRound
                }
            }
        }
    }
}

// Broadcast after the row staged an edit, so the menu can update its marks.
dispatcher Edited()

// The -/+ icons (the game's).
var MinusIcon: soft<Texture2D> = /Game/Assets/Icons/icons8-minus-90.icons8-minus-90
var PlusIcon: soft<Texture2D> = /Game/Assets/Icons/icons8-plus-90.icons8-plus-90
// The arrow icon for choices (pointing right; the left button shows it mirrored).
var ArrowIcon: soft<Texture2D> = /Game/Assets/Icons/icons8-play-100.icons8-play-100

// The row's option.
var Option: S_FL_ModOption
// The menu state the row reads and stages edits in.
var Menu: AC_FL_ModMenu
// Whether the controls are bound (once per widget).
var bBound: bool = false
// Whether Show has run (Construct refreshes the controls only then).
var bShown: bool = false
// Whether a Key row is waiting for the key to bind (after Change was clicked).
var bCapturing: bool = false
// Whether the number box is showing a refused entry (red until the player types again).
var bNumberError: bool = false

// Shows an option (or a group heading) with the control for its type and its shown value. Call before the row is added to the pane.
//
// In:  NewOption - the row from the registry.
//      NewMenu - the map's AC_FL_ModMenu.
// Out: none
fn Show(NewOption: S_FL_ModOption, NewMenu: AC_FL_ModMenu) {
    Option = NewOption
    Menu = NewMenu
    bShown = true
    Name.SetKey(name(NewOption.NameKey))
    if NewOption.Type == E_FL_ModOptionType.Group {
        // A heading as on the game's settings screen: the game's ball dividers either side of the name, which is centred and
        // in the serif heading font.
        Pill.SetBrushColor(LinearColor(R: 0.0, G: 0.0, B: 0.0, A: 0.0))
        BPL_FL_UI.StyleText(Name, 22.0)
        let nameSlot = cast(Name.Slot, HorizontalBoxSlot)
        if nameSlot != none {
            nameSlot.SetSize(SlateChildSize(SizeRule: ESlateSizeRule.Automatic, Value: 1.0))
            nameSlot.SetPadding(Margin(Left: 12, Top: 10, Right: 12, Bottom: 4))
        }
        LeftLine.SetVisibility(ESlateVisibility.Visible)
        RightLine.SetVisibility(ESlateVisibility.Visible)
        // The name's padding is 10 above and 4 below, so its centre is 3 below the row's; draw the dividers there too.
        LeftLine.SetRenderTranslation(Vector2D(X: 0.0, Y: 3.0))
        RightLine.SetRenderTranslation(Vector2D(X: 0.0, Y: 3.0))
        Mark.SetVisibility(ESlateVisibility.Collapsed)
        ControlBox.SetVisibility(ESlateVisibility.Collapsed)
        return
    }
    LeftLine.SetVisibility(ESlateVisibility.Collapsed)
    RightLine.SetVisibility(ESlateVisibility.Collapsed)
    if NewOption.DescKey != "" {
        // The game's tooltip: the option's name as the title, its description as the detail. On the name only.
        let tip = create_widget(WBP_FL_ModMenuTooltip)
        tip.Setup(NewOption.NameKey, NewOption.DescKey)
        Name.SetToolTip(tip)
        Name.SetVisibility(ESlateVisibility.Visible)
    }
    BPL_FL_UI.StyleMenuText(Name, 22.0, true)
    BPL_FL_UI.StyleMenuText(Mark, 22.0, true)
    BPL_FL_UI.StyleMenuText(ValueText, 22.0, true)
    BPL_FL_UI.StyleMenuText(ChoiceText, 22.0, true)
    BPL_FL_UI.StyleMenuText(PlainText, 22.0, true)
    MakePill()
    SetUpControls()
    Refresh()
}

// Gives the row a dark rounded pill behind it, like the game's settings rows.
//
// In:  none
// Out: none
fn MakePill() {
    let brush = Pill.Background
    brush.DrawAs = ESlateBrushDrawType.RoundedBox
    brush.TintColor = SlateColor(SpecifiedColor: LinearColor(R: 0.0, G: 0.0, B: 0.0, A: 0.55))
    let outline = brush.OutlineSettings
    outline.RoundingType = ESlateBrushRoundingType.HalfHeightRadius
    outline.Width = 0.0
    brush.OutlineSettings = outline
    Pill.SetBrush(brush)
    Pill.SetBrushColor(LinearColor(R: 1.0, G: 1.0, B: 1.0, A: 1.0))
}

// Shows the control for the option's type and gives the game widgets the menu's action names (once).
//
// In:  none
// Out: none
fn SetUpControls() {
    let isBool = Option.Type == E_FL_ModOptionType.Bool
    let isField = Option.Type == E_FL_ModOptionType.IntField || Option.Type == E_FL_ModOptionType.FloatField
    let isNumber = Option.Type == E_FL_ModOptionType.Int || Option.Type == E_FL_ModOptionType.Float || isField
    let isChoice = Option.Type == E_FL_ModOptionType.Choice
    let isText = Option.Type == E_FL_ModOptionType.Text
    let isKey = Option.Type == E_FL_ModOptionType.Key
    let isAction = Option.Type == E_FL_ModOptionType.Action
    Toggle.SetVisibility(if isBool { ESlateVisibility.Visible } else { ESlateVisibility.Collapsed })
    Stepper.SetVisibility(if isNumber || isChoice { ESlateVisibility.Visible } else { ESlateVisibility.Collapsed })
    TextInput.SetVisibility(if isText { ESlateVisibility.Visible } else { ESlateVisibility.Collapsed })
    KeyArea.SetVisibility(if isKey { ESlateVisibility.Visible } else { ESlateVisibility.Collapsed })
    ActionBox.SetVisibility(if isAction { ESlateVisibility.Visible } else { ESlateVisibility.Collapsed })
    PlainText.SetVisibility(ESlateVisibility.Collapsed)
    ValueText.SetVisibility(if isNumber && !isField { ESlateVisibility.Visible } else { ESlateVisibility.Collapsed })
    NumberInput.SetVisibility(if isField { ESlateVisibility.Visible } else { ESlateVisibility.Collapsed })
    ChoiceText.SetVisibility(if isChoice { ESlateVisibility.Visible } else { ESlateVisibility.Collapsed })
    if isNumber {
        SetButtonIcon(LeftButton, MinusIcon.load(), false)
        SetButtonIcon(RightButton, PlusIcon.load(), false)
    }
    if isChoice {
        SetButtonIcon(LeftButton, ArrowIcon.load(), true)
        SetButtonIcon(RightButton, ArrowIcon.load(), false)
    }
    if isText {
        StyleInputBox(TextInput)
    }
    if isField {
        StyleInputBox(NumberInput)
    }
    if isKey {
        BPL_FL_UI.SetupMenuButton(KeyButton, "Fretlib.ModMenu.Change", 18.0)
        BPL_FL_UI.StyleMenuText(KeyText, 18.0, true)
    }
    if isAction {
        BPL_FL_UI.SetupMenuButton(ActionButton, "Fretlib.ModMenu.Run", 18.0)
    }
    if bBound {
        return
    }
    bBound = true
    TextInput.OnTextChanged.bind(OnTextEdited)
    NumberInput.OnTextCommitted.bind(OnNumberCommitted)
    NumberInput.OnTextChanged.bind(OnNumberTyping)
    KeyButton.OnClicked.bind(OnKeyButtonClicked)
    ActionButton.OnClicked.bind(OnActionClicked)
    Toggle.clickActionEnable = HudAction(action: "Fretlib.ModMenu.On")
    Toggle.clickActionDisable = HudAction(action: "Fretlib.ModMenu.Off")
    LeftButton.action = HudAction(action: "Fretlib.ModMenu.Left")
    RightButton.action = HudAction(action: "Fretlib.ModMenu.Right")
    Toggle.OnHudActionDelegate.bind(OnHudAction)
    LeftButton.OnHudActionDelegate.bind(OnHudAction)
    RightButton.OnHudActionDelegate.bind(OnHudAction)
}

// Styles a text or number box like the menu: Germania One in gold on a dark brown rounded background (lighter when hovered or
// focused).
//
// In:  Target - the box.
// Out: none
fn StyleInputBox(Target: EditableTextBox) {
    let boxStyle = Target.WidgetStyle
    let textStyle = boxStyle.TextStyle
    textStyle.Font = BPL_FL_UI.MenuFont(textStyle.Font, 20.0)
    textStyle.ColorAndOpacity = SlateColor(SpecifiedColor: BPL_FL_UI.Gold())
    boxStyle.TextStyle = textStyle
    boxStyle.ForegroundColor = SlateColor(SpecifiedColor: BPL_FL_UI.Gold())
    boxStyle.FocusedForegroundColor = SlateColor(SpecifiedColor: BPL_FL_UI.Gold())
    boxStyle.BackgroundColor = SlateColor(SpecifiedColor: LinearColor(R: 1.0, G: 1.0, B: 1.0, A: 1.0))
    boxStyle.BackgroundImageNormal = BPL_FL_UI.RoundedBrush(boxStyle.BackgroundImageNormal, LinearColor(R: 0.024, G: 0.014, B: 0.005, A: 1.0))
    boxStyle.BackgroundImageHovered = BPL_FL_UI.RoundedBrush(boxStyle.BackgroundImageHovered, LinearColor(R: 0.045, G: 0.028, B: 0.010, A: 1.0))
    boxStyle.BackgroundImageFocused = BPL_FL_UI.RoundedBrush(boxStyle.BackgroundImageFocused, LinearColor(R: 0.045, G: 0.028, B: 0.010, A: 1.0))
    boxStyle.Padding = Margin(Left: 12, Top: 4, Right: 12, Bottom: 4)
    Target.WidgetStyle = boxStyle
}

// Gives one of the round buttons an icon in the game's gold.
//
// In:  Target - the button.
//      Icon - the icon texture (none leaves the button's own).
//      bMirrored - true to mirror the icon left-right (the left arrow).
// Out: none
fn SetButtonIcon(Target: RoundedButton, Icon: Texture2D, bMirrored: bool) {
    if Icon == none {
        return
    }
    let tint = SlateColor(SpecifiedColor: BPL_FL_UI.Gold())
    Target.iconTexture = Icon
    Target.iconSize = 18.0
    Target.IconTintColor = tint
    Target.SetButtonIcon(Icon, 18.0)
    Target.icon.SetColorAndOpacity(BPL_FL_UI.Gold())
    Target.icon.SetRenderScale(Vector2D(X: if bMirrored { -1.0 } else { 1.0 }, Y: 1.0))
}

// Shows the option's current value (the pending edit if any) and the unapplied-changes mark.
//
// In:  none
// Out: none
fn Refresh() {
    if Menu == none {
        return
    }
    let shown = Menu.GetShownValue(Option.ModId, Option.OptionId)
    RefreshMark()
    // The buttons are 36 high: their labels need the smaller size to fit (set again once shown, as the bottom bar does).
    BPL_FL_UI.StyleMenuText(KeyButton.ButtonText, 18.0, false)
    BPL_FL_UI.StyleMenuText(ActionButton.ButtonText, 18.0, false)
    BPL_FL_UI.CentreMenuButtonLabel(KeyButton.ButtonText)
    BPL_FL_UI.CentreMenuButtonLabel(ActionButton.ButtonText)
    if Option.Type == E_FL_ModOptionType.Text {
        // Not while the player is typing: setting the text would move the cursor.
        if !TextInput.HasKeyboardFocus() {
            TextInput.SetText(text(shown))
        }
        return
    }
    if Option.Type == E_FL_ModOptionType.Key {
        ShowKey(shown)
        return
    }
    if Option.Type == E_FL_ModOptionType.Action {
        return
    }
    if Option.Type == E_FL_ModOptionType.IntField || Option.Type == E_FL_ModOptionType.FloatField {
        // Not while the player is typing: setting the text would move the cursor.
        if !NumberInput.HasKeyboardFocus() {
            NumberInput.SetText(NumberDisplay(shown))
        }
        return
    }
    if Option.Type == E_FL_ModOptionType.Bool {
        // The game's toggle ignores a state it believes it already has, and a new toggle believes it is off while drawn with
        // its knob on the right; switching through the opposite state makes it redraw either way.
        let on = shown == "true"
        Toggle.SetSelected(!on)
        Toggle.SetSelected(on)
        return
    }
    if Option.Type == E_FL_ModOptionType.Int {
        ValueText.SetText(text(shown))
        return
    }
    if Option.Type == E_FL_ModOptionType.Float {
        ValueText.SetText(FormatFloat(float(shown)))
        return
    }
    if Option.Type == E_FL_ModOptionType.Choice {
        ChoiceText.SetKey(name(shown))
        return
    }
    PlainText.SetText(text(shown))
}

// Shows or hides the unapplied-changes mark.
//
// In:  none
// Out: none
fn RefreshMark() {
    let shown = Menu.GetShownValue(Option.ModId, Option.OptionId)
    let applied = Menu.GetValue(Option.ModId, Option.OptionId)
    Mark.SetVisibility(if shown != applied.ReturnValue { ESlateVisibility.Visible } else { ESlateVisibility.Hidden })
}

// Shows a key as the game shows keybinds: its input icon (the game maps the key), or its name for keys without one (e.g. the
// digit keys). The Change button reads "Press a key" while capturing.
//
// In:  KeyName - the key's name, as OptionManager.KeyToString writes it.
// Out: none
fn ShowKey(KeyName: string) {
    KeyButton.SetLabelText(if bCapturing { "Fretlib.ModMenu.PressKey" } else { "Fretlib.ModMenu.Change" })
    let iconId = ArcoGameInstance.FKeyToInputIcon(self, OptionManager.StringToKey(KeyName))
    if iconId != EInputIconButton.None {
        KeyIcon.ButtonToShow = iconId
        KeyIcon.SetButtonToShow(iconId)
        KeyIcon.SetVisibility(ESlateVisibility.Visible)
        KeyText.SetVisibility(ESlateVisibility.Collapsed)
    } else {
        KeyText.SetText(text(KeyName))
        KeyText.SetVisibility(ESlateVisibility.Visible)
        KeyIcon.SetVisibility(ESlateVisibility.Collapsed)
    }
}

// Stages the text box's text as it is typed.
//
// In:  NewText - the box's text now.
// Out: none
fn OnTextEdited(NewText: ref text) {
    Menu.StageValue(Option.ModId, Option.OptionId, string(NewText))
    RefreshMark()
    Edited.broadcast()
}

// Starts capturing a key: the row takes keyboard focus and the next key pressed (Esc cancels) becomes the pending value.
//
// In:  none
// Out: none
fn OnKeyButtonClicked() {
    bCapturing = true
    bIsFocusable = true
    SetKeyboardFocus()
    Refresh()
}

// Fires the option's action at once (actions aren't pending).
//
// In:  none
// Out: none
fn OnActionClicked() {
    Menu.PressAction(Option.ModId, Option.OptionId)
}

// A number field's value as shown in its box: a whole number for IntField, the option's decimal places for FloatField.
//
// In:  Value - the stored value.
// Out: Return - the text.
fn NumberDisplay(Value: string) -> text {
    if Option.Type == E_FL_ModOptionType.FloatField {
        return FormatFloat(float(Value))
    }
    return text(Value)
}

// Checks a committed number box: a number is rounded (whole, or to the option's decimal places), clamped to the range and
// staged; anything else is refused, shown in red, and the box goes back to the last good value. Esc (cleared) only restores
// the box.
//
// In:  NewText - the box's text.
//      Method - how it was committed (Enter, focus lost, cleared by Esc).
// Out: none
fn OnNumberCommitted(NewText: ref text, Method: ETextCommit) {
    let entered = KismetStringLibrary.TrimTrailing(KismetStringLibrary.Trim(string(NewText)))
    let current = Menu.GetShownValue(Option.ModId, Option.OptionId)
    if Method == ETextCommit.OnCleared {
        NumberInput.SetText(NumberDisplay(current))
        return
    }
    if !KismetStringLibrary.IsNumeric(entered) {
        bNumberError = true
        NumberInput.SetForegroundColor(LinearColor(R: 0.8, G: 0.12, B: 0.08, A: 1.0))
        NumberInput.SetText(NumberDisplay(current))
        return
    }
    let typed = float(entered)
    let cleaned = ""
    if Option.Type == E_FL_ModOptionType.IntField {
        cleaned = string(KismetMathLibrary.Clamp(KismetMathLibrary.Round(typed), int(Option.Min), int(Option.Max)))
    } else {
        let scale = 1.0
        for i in 1..Option.Decimals {
            scale = scale * 10.0
        }
        let rounded = float(KismetMathLibrary.Round(typed * scale)) / scale
        cleaned = string(KismetMathLibrary.FClamp(rounded, Option.Min, Option.Max))
    }
    Menu.StageValue(Option.ModId, Option.OptionId, cleaned)
    let staged = Menu.GetShownValue(Option.ModId, Option.OptionId)
    NumberInput.SetText(NumberDisplay(staged))
    RefreshMark()
    Edited.broadcast()
}

// Takes the refused-entry red off the number box as soon as the player types again.
//
// In:  NewText - the box's text now.
// Out: none
fn OnNumberTyping(NewText: ref text) {
    if bNumberError {
        bNumberError = false
        NumberInput.SetForegroundColor(BPL_FL_UI.Gold())
    }
}

// A number with the option's decimal places.
//
// In:  Value - the number.
// Out: Return - the text.
fn FormatFloat(Value: float) -> text {
    return KismetTextLibrary.Conv_DoubleToText(Value, ERoundingMode.HalfToEven, false, true, 1, 324, Option.Decimals, Option.Decimals)
}

// Applies a click on the row's controls: the toggle turns a Bool on or off; the left and right buttons step a number by its
// step (within its range) or move a choice to the previous or next one (wrapping round). The edit is staged, not applied.
//
// In:  Action - the HudAction the game widget sent.
// Out: none
fn OnHudAction(Action: HudAction) {
    let shown = Menu.GetShownValue(Option.ModId, Option.OptionId)
    let newValue = shown
    let direction = if Action.action == "Fretlib.ModMenu.Right" { 1 } else { -1 }
    if Action.action == "Fretlib.ModMenu.On" {
        newValue = "true"
    }
    if Action.action == "Fretlib.ModMenu.Off" {
        newValue = "false"
    }
    if Action.action == "Fretlib.ModMenu.Left" || Action.action == "Fretlib.ModMenu.Right" {
        if Option.Type == E_FL_ModOptionType.Int || Option.Type == E_FL_ModOptionType.IntField {
            let stepped = int(shown) + direction * int(Option.Step)
            newValue = string(KismetMathLibrary.Clamp(stepped, int(Option.Min), int(Option.Max)))
        }
        if Option.Type == E_FL_ModOptionType.Float || Option.Type == E_FL_ModOptionType.FloatField {
            let steps = KismetMathLibrary.Round(float(shown) / Option.Step) + direction
            let f = KismetMathLibrary.FClamp(float(steps) * Option.Step, Option.Min, Option.Max)
            newValue = string(f)
        }
        if Option.Type == E_FL_ModOptionType.Choice {
            let count = Option.Choices.Length()
            if count > 0 {
                let index = Option.Choices.Find(shown)
                let nextIndex = (index + direction + count) % count
                newValue = Option.Choices[nextIndex]
            }
        }
    }
    if newValue != shown {
        Menu.StageValue(Option.ModId, Option.OptionId, newValue)
    }
    Refresh()
    Edited.broadcast()
}

// Shows the controls' state again once the row is on screen: the game's widgets reset themselves when they are first built,
// so a state set before that (in Show) is lost.
on Construct {
    if bShown {
        if Option.Type != E_FL_ModOptionType.Group {
            BPL_FL_UI.CentreMenuButtonLabel(KeyButton.ButtonText)
            BPL_FL_UI.CentreMenuButtonLabel(ActionButton.ButtonText)
            Refresh()
        }
    }
}

// While capturing a key, takes the next key pressed as the pending value (Esc cancels); other keys go on to the menu.
//
// In:  MyGeometry - the row's geometry.
//      InKeyEvent - the key.
// Out: Return - Handled while capturing, Unhandled otherwise.
on OnKeyDown(MyGeometry: Geometry, InKeyEvent: KeyEvent) -> EventReply {
    if !bCapturing {
        return WidgetBlueprintLibrary.Unhandled()
    }
    let pressed = OptionManager.KeyToString(KismetInputLibrary.GetKey(InKeyEvent))
    bCapturing = false
    if pressed != "Escape" {
        Menu.StageValue(Option.ModId, Option.OptionId, pressed)
    }
    Refresh()
    Edited.broadcast()
    return WidgetBlueprintLibrary.Handled()
}

// Stops capturing a key if the row loses keyboard focus (e.g. the player clicks elsewhere).
//
// In:  InFocusEvent - the focus change.
on OnFocusLost(InFocusEvent: FocusEvent) {
    if bCapturing {
        bCapturing = false
        Refresh()
    }
}
